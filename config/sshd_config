# SSH Server Configuration for GeoServer DevDocker
# Optimized for IDE connectivity with security best practices

# Port and protocol
Port 22
Protocol 2

# Key exchange algorithms
# Excludes sntrup761x25519-sha512@openssh.com (post-quantum KEX, default in
# OpenSSH 9.x): older/Windows OpenSSH clients (Win32-OpenSSH bundled with
# Windows) advertise support for it but fail to actually negotiate it,
# causing "choose_kex: unsupported KEX method" on ssh-keyscan/ssh/scp.
# See docs/SSH-HOST-KEY-VERIFICATION.md for details.
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group14-sha256

# Authentication
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no

# Root login (required for container environment)
PermitRootLogin prohibit-password

# Key-based authentication settings
AuthorizedKeysFile .ssh/authorized_keys

# Disable unused authentication methods
KerberosAuthentication no
GSSAPIAuthentication no

# Security settings
X11Forwarding yes
PrintMotd no
PrintLastLog yes
TCPKeepAlive yes
PermitUserEnvironment no

# Logging
SyslogFacility AUTH
LogLevel INFO

# Session settings
UsePAM yes
AcceptEnv LANG LC_*

# Subsystems
Subsystem sftp /usr/lib/openssh/sftp-server
